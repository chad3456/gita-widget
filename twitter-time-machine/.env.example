# Copy to .env and fill in as needed.

# Port the server listens on (Render/Railway/Fly set this automatically).
PORT=3000

# Optional: enable the "Official X API" source.
# Get a Bearer Token from https://developer.twitter.com (a project + app).
# Full history back to 2012 requires an elevated tier (Academic/Pro/Enterprise);
# Basic/Free tokens fall back to the account's most recent tweets only.
X_BEARER_TOKEN=

# Set to "production" on your host for combined access logs + caching headers.
NODE_ENV=development
